generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}

enum TipoProyecto {
  SISTEMA_GESTION
  TIENDA_WEB
  SAAS
  AUTOMATIZACION_IA
  OTRO
}

enum EstadoProyecto {
  EN_DESARROLLO
  ACTIVO
  PAUSADO
  FINALIZADO
}

enum EstadoCobro {
  PENDIENTE
  PARCIAL
  PAGADO
  MANTENIMIENTO
}

enum EstadoTicket {
  NUEVO
  EN_REVISION
  RESUELTO
}

enum PrioridadTicket {
  BAJA
  MEDIA
  ALTA
}

enum OrigenTicket {
  CLIENTE
  SISTEMA
}

enum EstadoConsulta {
  NUEVA
  CONTACTADA
  CONTRATADA
  DESCARTADA
}

enum NecesidadConsulta {
  SISTEMA_GESTION
  AUTOMATIZACION_IA
  TIENDA_WEB
  INTEGRACIONES
  MANTENIMIENTO
  NO_SE
}

model Proyecto {
  id              String         @id @default(cuid())
  clienteNombre   String
  nombreProyecto  String
  tipo            TipoProyecto
  estado          EstadoProyecto @default(EN_DESARROLLO)
  stack           String?
  urlProduccion   String?
  adminStatsUrl   String?        // endpoint /admin/stats del backend del cliente, para el Centro de control
  notas           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Portfolio público (landing)
  mostrarEnLanding     Boolean  @default(false)
  tagsPortfolio        String[] @default([])
  imagenPortfolioUrl   String?
  descripcionPortfolio String? // descripción pública, distinta de "notas" (interno)
  linkPublico          String?
  resenaTexto          String?
  resenaAutor          String? // ej: "Dueño de [rubro]", nunca nombre real ni datos sensibles del cliente

  cobros  Cobro[]
  tickets Ticket[]
}

model Cobro {
  id            String      @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  montoTotal    Decimal     @db.Decimal(12, 2)
  montoCobrado  Decimal     @default(0) @db.Decimal(12, 2)
  estado        EstadoCobro @default(PENDIENTE)
  notas         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Ticket {
  id                 String          @id @default(cuid())
  proyectoId         String
  proyecto           Proyecto        @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  asunto             String
  descripcion        String
  estado             EstadoTicket    @default(NUEVO)
  prioridad          PrioridadTicket @default(MEDIA)
  origen             OrigenTicket    @default(CLIENTE)
  remitenteNombre    String?
  remitenteEmail     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ConfiguracionAgencia {
  id          String   @id @default(cuid())
  razonSocial String
  email       String
  whatsapp    String
  updatedAt   DateTime @updatedAt
}

model Consulta {
  id         String            @id @default(cuid())
  nombre     String
  email      String
  telefono   String?
  empresa    String?
  necesidad  NecesidadConsulta
  mensaje    String
  estado     EstadoConsulta    @default(NUEVA)
  createdAt  DateTime          @default(now())
}